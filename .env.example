# Kopiere diese Datei nach .env und trage deine Werte ein.
# Die .env-Datei wird NICHT eingecheckt (.gitignore).

# Token von @BotFather (Telegram -> /newbot)
TELEGRAM_BOT_TOKEN=123456789:AAH-dein-token-hier

# Deine Chat-ID: Bot starten, ihm /start schreiben, er antwortet mit der ID.
TELEGRAM_CHAT_ID=

# Optional: eigener Telegram-Bot-API-Server (normalerweise leer lassen)
# TELEGRAM_API_BASE_URL=
